obj painting in room_46 "Oil Painting"
  desc "An old oil painting in a heavy frame."
  portable true
  verb examine
    say "An old oil painting in a heavy frame."

obj ring in hidden_store "Diamond Ring"
  desc "A diamond ring which glitters even in the poor light."
  portable true
  verb examine
    say "A diamond ring which glitters even in the poor light."

obj magic_spells in hidden_store "Book of Magic Spells"
  desc "A heavy book filled with evil looking symbols and one useful spell."
  portable true
  verb examine
    say "A heavy book filled with evil looking symbols and one useful spell."
  verb read
    say "One spell is clear enough to pronounce: XZANFAR."

obj goblet in room_50 "Jewelled Goblet"
  desc "A jewelled goblet, valuable and slightly sinister."
  portable true
  verb examine
    say "A jewelled goblet, valuable and slightly sinister."

obj scroll in room_13 "Ancient Scroll"
  desc "An ancient scroll covered in cramped writing."
  portable true
  verb examine
    say "An ancient scroll covered in cramped writing."
  verb read
    say "The scroll warns that bats guard the turret room and that evil works fear the word XZANFAR."

obj coins in room_18 "Bag of Gold Coins"
  desc "A heavy bag of gold coins."
  portable true
  verb examine
    say "A heavy bag of gold coins."

obj statue in room_28 "Ebony Statue"
  desc "A small ebony statue with polished eyes."
  portable true
  verb examine
    say "A small ebony statue with polished eyes."

obj candlestick in room_42 "Gold Candlestick"
  desc "A gold candlestick large enough to hold the candle."
  portable true
  verb examine
    say "A gold candlestick large enough to hold the candle."

obj matches in room_10 "Matches"
  desc "A box containing a few dry matches."
  portable true
  verb examine
    say "A box containing a few dry matches."

obj vacuum in room_25 "Portable Vacuum Cleaner"
  desc "A portable vacuum cleaner with an empty battery compartment."
  portable true
  state powered = false
  verb examine
    say "A portable vacuum cleaner with an empty battery compartment."

obj batteries in room_26 "Batteries"
  desc "A pair of batteries which fit the vacuum cleaner."
  portable true
  verb examine
    say "A pair of batteries which fit the vacuum cleaner."

obj shovel in room_04 "Shovel"
  desc "A sturdy shovel."
  portable true
  verb examine
    say "A sturdy shovel."

obj axe in room_02 "Axe"
  desc "A sharp axe left beside the woodpile."
  portable true
  verb examine
    say "A sharp axe left beside the woodpile."

obj rope in room_07 "Rope"
  desc "A long coil of rope."
  portable true
  verb examine
    say "A long coil of rope."

obj boat in room_47 "Boat"
  desc "A small boat which looks barely fit for the marsh."
  portable true
  verb examine
    say "A small boat which looks barely fit for the marsh."

obj aerosol in room_60 "Aerosol Can"
  desc "A can labelled 'Baticide'."
  portable true
  verb examine
    say "A can labelled 'Baticide'."

obj candle in hidden_store "Candle"
  desc "A plain wax candle."
  portable true
  state lit = false
  verb examine
    say "A plain wax candle."

obj key in hidden_store "Iron Key"
  desc "A large iron key."
  portable true
  verb examine
    say "A large iron key."

obj desk in room_43 "Desk"
  desc "A dusty desk with a single drawer."
  portable false
  verb examine
    say "The desk has a drawer. It may be worth opening."

obj drawer in room_43 "Drawer"
  desc "The drawer is closed."
  portable false
  state open = false
  verb open
    if drawer.open
      say "The drawer is already open."
    else
      set drawer.open = true
      move candle to room_43
      say "You open the drawer and discover a candle."

obj coat in room_32 "Hanging Coat"
  desc "A long coat hangs in the cupboard."
  portable false
  verb examine
    move key to room_32
    say "You search the coat and find a large iron key in its pocket."

obj coffin in room_38 "Coffin"
  desc "A stone coffin rests in the deep cellar."
  portable false
  state open = false
  verb open
    if coffin.open
      say "The coffin is already open."
    else
      set coffin.open = true
      move ring to room_38
      say "The lid grinds aside. A diamond ring lies within."

obj bats in room_13 "Bats"
  desc "A cloud of bats circles the turret room."
  portable false
  state dispersed = false
  verb examine
    if bats.dispersed
      say "The bats have fled."
    else
      say "The bats swoop close whenever you approach the scroll."

obj false_wall in room_35 "False Wall"
  desc "One part of the wall sounds hollow."
  portable false
  state broken = false
  verb examine
    say "The wall sounds hollow. A heavy cutting tool might break it."

obj locked_door in room_28 "Locked Door"
  desc "A thick wooden door blocks the hall."
  portable false
  state unlocked = false
  verb examine
    if locked_door.unlocked
      say "The door stands unlocked."
    else
      say "The door is locked."

obj ghosts in room_52 "Paralysing Ghosts"
  desc "Pale ghosts drift across the upper gallery."
  portable false
  state removed = false
  verb examine
    if ghosts.removed
      say "Only wisps of ectoplasm remain."
    else
      say "The ghosts reach towards you and stop you passing safely."

obj barrier in room_45 "Magical Barrier"
  desc "A magical barrier shimmers to the west."
  portable false
  state dispelled = false
  verb examine
    if barrier.dispelled
      say "The magical barrier has vanished."
    else
      say "The barrier crackles with hostile magic."

obj bars in room_30 "Barred Window"
  desc "Iron bars cover the cellar window."
  portable false
  state removed = false
  verb examine
    if bars.removed
      say "The bars have been dug out of the wall."
    else
      say "The bars are firmly set into crumbling mortar."

obj marsh in room_54 "Marsh"
  desc "The marsh mud is deep and treacherous."
  portable false
  verb examine
    say "Crossing safely will require something which floats."

obj scorecard in room_57 "Scorecard"
  desc "A card for checking which treasures you carry."
  portable false
  verb score
    say "Treasures currently carried:"
    if have painting
      say "  Painting"
    if have ring
      say "  Ring"
    if have magic_spells
      say "  Magic Spells"
    if have goblet
      say "  Goblet"
    if have scroll
      say "  Scroll"
    if have coins
      say "  Coins"
    if have statue
      say "  Statue"
    if have candlestick
      say "  Candlestick"
    say "There are eight treasures in all. Return to the iron gate carrying them to complete the adventure."

rule use matches on candle
  if have matches and have candle
    if candle.lit
      say "The candle is already alight."
    else
      set candle.lit = true
      say "The candle casts a flickering light."
  else
    say "You need both the candle and the matches."

rule use batteries on vacuum
  if have batteries and have vacuum
    set vacuum.powered = true
    say "You fit the batteries. The vacuum cleaner hums into life."
  else
    say "You need the vacuum cleaner and its batteries."

rule use aerosol on bats
  if have aerosol
    set bats.dispersed = true
    say "Pfft. The bats scatter, leaving the scroll unguarded."
  else
    say "You need something which will drive the bats away."

rule use axe on false_wall
  if have axe
    set false_wall.broken = true
    move magic_spells to room_35
    say "You swing the axe. The false wall collapses and reveals a secret book of spells."
  else
    say "You need a suitable tool."

rule use key on locked_door
  if have key
    set locked_door.unlocked = true
    say "The key turns in the lock."
  else
    say "You do not have the key."

rule use vacuum on ghosts
  if have vacuum and vacuum.powered
    set ghosts.removed = true
    say "Whizz. The vacuum cleaner sucks up the paralysing ghosts."
  elif have vacuum
    say "The vacuum cleaner has no power."
  else
    say "You need the portable vacuum cleaner."

rule use magic_spells on barrier
  if have magic_spells
    set barrier.dispelled = true
    say "You speak XZANFAR. The magical barrier dissolves."
  else
    say "You do not know the necessary spell."

rule use shovel on bars
  if have shovel
    set bars.removed = true
    say "You dig around the edge of the bars until they come free."
  else
    say "You need a digging tool."

rule use boat on marsh
  if have boat
    say "You launch the boat and cross the marsh, but it becomes stuck in the mud."
    move boat to room_54
  else
    say "The mud is too deep to cross safely."

rule use candle on candlestick
  if have candle and have candlestick
    say "You place the candle in the gold candlestick."
  else
    say "You need the candle and the candlestick."
