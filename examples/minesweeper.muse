room puzzle_arcade "Puzzle Arcade"
  desc "A quiet corner of the arcade glows with old puzzle terminals."

goal mine_clearance
  desc "Clear every safe square in the demo minesweeper game."

goal mine_blast
  desc "Trigger a mine in the demo minesweeper game."

object minesweeper_terminal in puzzle_arcade from device
  alias terminal "minesweeper" "mine sweeper"
  desc "A sturdy terminal running a compact game of minesweeper."

  state active = false
  state game_over = false
  state open_count = 0
  state safe_to_open = 20
  state flagged_count = 0

  array mine[5,5] = false
  array open[5,5] = false
  array flagged[5,5] = false
  array adjacent[5,5] = 0
  array display[5,5] = "#"

  verb play
    run start_game

  verb reset
    run start_game

  routine start_game
    set this.active = true
    set this.game_over = false
    set this.open_count = 0
    set this.flagged_count = 0
    set this.safe_to_open = 20

    for x = 1 to size(this.mine, 1)
      for y = 1 to size(this.mine, 2)
        set this.mine[x,y] = false
        set this.open[x,y] = false
        set this.flagged[x,y] = false
        set this.adjacent[x,y] = 0
        set this.display[x,y] = "#"

    set this.mine[1,5] = true
    set this.mine[2,2] = true
    set this.mine[3,4] = true
    set this.mine[4,1] = true
    set this.mine[5,3] = true

    for x = 1 to size(this.mine, 1)
      for y = 1 to size(this.mine, 2)
        let count = 0
        for dx = -1 to 1
          for dy = -1 to 1
            if dx != 0 or dy != 0
              let nx = x + dx
              let ny = y + dy
              if nx >= 1 and nx <= size(this.mine, 1) and ny >= 1 and ny <= size(this.mine, 2)
                if this.mine[nx,ny]
                  set count += 1
        set this.adjacent[x,y] = count

    say "New minesweeper game started."
    say "Commands: BOARD, REVEAL <x> <y>, FLAG <x> <y>, RESET."
    say "Coordinates run from 1 to 5."
    run board

  verb board
    run board

  verb reveal <x:int> <y:int>
    if not this.active
      say "No game is active. Type PLAY to start."
      stop

    if this.game_over
      say "The game is over. Type RESET to start again."
      stop

    if x < 1 or x > size(this.mine, 1) or y < 1 or y > size(this.mine, 2)
      say "Coordinates must be between 1 and 5."
      stop

    if this.flagged[x,y]
      say "That square is flagged. Remove the flag first if you want to reveal it."
      stop

    if this.open[x,y]
      say "That square is already open."
      stop

    set this.open[x,y] = true

    if this.mine[x,y]
      set this.game_over = true
      set this.active = false
      run reveal_all_mines
      run board
      say "Boom. You hit a mine at {x},{y}."
      achieve mine_blast
      stop

    set this.open_count += 1
    run board

    if this.adjacent[x,y] == 0
      say "Square {x},{y} is clear."
    else
      say "Square {x},{y} shows {this.adjacent[x,y]} adjacent mine(s)."

    if this.open_count >= this.safe_to_open
      set this.game_over = true
      set this.active = false
      say "You cleared every safe square."
      achieve mine_clearance

  verb flag <x:int> <y:int>
    if not this.active
      say "No game is active. Type PLAY to start."
      stop

    if this.game_over
      say "The game is over. Type RESET to start again."
      stop

    if x < 1 or x > size(this.mine, 1) or y < 1 or y > size(this.mine, 2)
      say "Coordinates must be between 1 and 5."
      stop

    if this.open[x,y]
      say "That square is already open."
      stop

    if this.flagged[x,y]
      set this.flagged[x,y] = false
      set this.flagged_count -= 1
      say "Flag removed from {x},{y}."
    else
      set this.flagged[x,y] = true
      set this.flagged_count += 1
      say "Flag placed on {x},{y}."

    run board

  routine reveal_all_mines
    for x = 1 to size(this.mine, 1)
      for y = 1 to size(this.mine, 2)
        if this.mine[x,y]
          set this.open[x,y] = true

  routine board
    for x = 1 to size(this.display, 1)
      for y = 1 to size(this.display, 2)
        if this.flagged[x,y]
          set this.display[x,y] = "F"
        elif not this.open[x,y]
          set this.display[x,y] = "#"
        elif this.mine[x,y]
          set this.display[x,y] = "*"
        elif this.adjacent[x,y] == 0
          set this.display[x,y] = "."
        else
          set this.display[x,y] = this.adjacent[x,y]

    say "    1 2 3 4 5"
    say "1 | {this.display[1,1]} {this.display[1,2]} {this.display[1,3]} {this.display[1,4]} {this.display[1,5]}"
    say "2 | {this.display[2,1]} {this.display[2,2]} {this.display[2,3]} {this.display[2,4]} {this.display[2,5]}"
    say "3 | {this.display[3,1]} {this.display[3,2]} {this.display[3,3]} {this.display[3,4]} {this.display[3,5]}"
    say "4 | {this.display[4,1]} {this.display[4,2]} {this.display[4,3]} {this.display[4,4]} {this.display[4,5]}"
    say "5 | {this.display[5,1]} {this.display[5,2]} {this.display[5,3]} {this.display[5,4]} {this.display[5,5]}"
    say "Open: {this.open_count} / {this.safe_to_open} safe squares. Flags: {this.flagged_count}."
