@dig Museum Workshop;workshop
#
@desc here = A maintenance bench stands beneath rows of vintage test equipment.
#
@create Maintenance Panel;panel;hatch
#
@tel panel = workshop
#
@desc panel = A brushed metal maintenance panel with two stubborn screws.
#
set panel/open:muse = False
#
set panel/interactions:muse = [{'id': 'examine', 'verb': 'examine', 'aliases': ['inspect'], 'behaviour': 'behaviours.common.simple_message.SimpleMessage', 'hint': None, 'status': None, 'message': 'The panel is secured by two flat-bladed screws.', 'config': {}}, {'id': 'open', 'verb': 'open', 'aliases': [], 'behaviour': 'behaviours.common.conditional_verbs.ConditionalVerbCmdSet', 'hint': None, 'status': None, 'message': None, 'config': {'program': [{'op': 'if', 'branches': [{'condition': ['truthy', 'panel.open'], 'then': [['say', 'The maintenance panel is already open.']]}], 'else': [['say', 'The screws prevent the panel from opening.']]}]}}]
#
set panel/macro_rules:muse = [{'id': 'use_screwdriver_on_panel', 'verb': 'use', 'direct_object': 'screwdriver', 'preposition': 'on', 'target_object': 'panel', 'handler': 'behaviours.common.use_on_target.UseOnTargetCmdSet', 'program': [{'op': 'if', 'branches': [{'condition': ['truthy', 'panel.open'], 'then': [['say', 'The panel is already open.']]}, {'condition': ['have', 'screwdriver'], 'then': [['set', 'panel.open', True], ['say', 'You loosen the screws and swing the maintenance panel open.']]}], 'else': [['say', 'You need to be carrying the screwdriver.']]}]}]
#
py self.search("panel")[0].cmdset.add("behaviours.common.conditional_verbs.ConditionalVerbCmdSet", persistent=True)
#
py self.search("panel")[0].cmdset.add("behaviours.common.simple_message.SimpleMessage", persistent=True)
#
py self.search("panel")[0].cmdset.add("behaviours.common.use_on_target.UseOnTargetCmdSet", persistent=True)
#
@create Screwdriver;screwdriver;tool
#
@tel screwdriver = workshop
#
@desc screwdriver = A broad, flat-bladed screwdriver.
#
@lock screwdriver = get:true()
#
@create Museum Badge;badge;pass
#
@tel badge = workshop
#
@desc badge = A temporary museum access badge.
#
@lock badge = get:true()
#
@create Curator;curator;volunteer
#
@tel curator = workshop
#
@desc curator = A museum volunteer waits beside the workbench.
#
set curator/interactions:muse = [{'id': 'talk', 'verb': 'talk', 'aliases': ['greet'], 'behaviour': 'behaviours.common.dialogue.DialogueCmdSet', 'hint': None, 'status': None, 'message': None, 'config': {'dialogue_entry': 'greeting'}}]
#
set curator/dialogue:muse = {'behaviour': 'behaviours.common.dialogue.DialogueCmdSet', 'entry': 'greeting', 'nodes': {'greeting': {'program': [['say', 'The curator glances at the maintenance panel.'], ['option', 'help', 'Can I help with the repair?', 'h', ['have', 'badge'], 'approved'], ['option', 'leave', 'not right now.', 'n', None, 'goodbye']], 'say': ['The curator glances at the maintenance panel.'], 'options': [{'id': 'help', 'label': 'Can I help with the repair?', 'hotkey': 'h', 'condition': ['have', 'badge'], 'target': 'approved'}, {'id': 'leave', 'label': 'not right now.', 'hotkey': 'n', 'condition': None, 'target': 'goodbye'}]}, 'approved': {'program': [['say', 'Certainly. Use the screwdriver on the panel.'], ['set', 'curator.approved', True], ['end']], 'say': ['Certainly. Use the screwdriver on the panel.'], 'actions': [['set', 'curator.approved', True], ['end']]}, 'goodbye': {'program': [['say', 'Come back when you are ready.'], ['end']], 'say': ['Come back when you are ready.'], 'actions': [['end']]}}}
#
py self.search("curator")[0].cmdset.add("behaviours.common.dialogue.DialogueCmdSet", persistent=True)
#
