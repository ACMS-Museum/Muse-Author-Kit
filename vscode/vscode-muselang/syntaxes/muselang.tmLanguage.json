{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "MuseLang",
  "scopeName": "source.muselang",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#headers"
    },
    {
      "include": "#properties"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#header_forms"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.muselang",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.muselang",
          "match": "\"(?:[^\"\\\\]|\\\\.)*\""
        }
      ]
    },
    "headers": {
      "patterns": [
        {
          "match": "^(\\s*)(room|object|character|goal|routine|verb|state|array)\\b\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "2": {
              "name": "keyword.declaration.muselang"
            },
            "3": {
              "name": "entity.name.function.muselang"
            }
          }
        }
      ]
    },
    "header_forms": {
      "patterns": [
        {
          "match": "^(\\s*object\\s+)([A-Za-z_][A-Za-z0-9_]*)(\\s+in\\s+)([A-Za-z_][A-Za-z0-9_]*)(\\s+from\\s+[A-Za-z_][A-Za-z0-9_]*)?",
          "captures": {
            "1": {
              "name": "keyword.declaration.muselang"
            },
            "2": {
              "name": "entity.name.function.muselang"
            },
            "3": {
              "name": "keyword.other.muselang"
            },
            "4": {
              "name": "entity.name.type.muselang"
            },
            "5": {
              "name": "keyword.other.muselang"
            }
          }
        },
        {
          "match": "^(\\s*)(desc|say|hint|let|set|run|move|achieve|call|stop|end)\\b",
          "captures": {
            "2": {
              "name": "keyword.declaration.muselang"
            },
            "3": {
              "name": "keyword.control.muselang"
            }
          }
        },
        {
          "match": "^(\\s*)(if|elif|else|for)\\b",
          "captures": {
            "2": {
              "name": "keyword.control.muselang"
            }
          }
        }
      ]
    },
    "properties": {
      "patterns": [
        {
          "match": "\\b(alias|desc|state|array|from|in|to|step|player|team|scenario|game|world|this|real)\\b",
          "name": "keyword.other.muselang"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "match": "\\b(if|elif|else|for|say|hint|let|set|run|move|achieve|call|stop|end)\\b",
          "name": "keyword.control.muselang"
        },
        {
          "match": "\\b(not|and|or)\\b",
          "name": "keyword.operator.word.muselang"
        },
        {
          "match": "\\b(true|false)\\b",
          "name": "constant.language.boolean.muselang"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "match": "\\b-?\\d+(?:\\.\\d+)?\\b",
          "name": "constant.numeric.muselang"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "match": "==|!=|>=|<=|=|\\+\\=|-\\=|\\*\\=|/\\=|\\+|-|\\*|/",
          "name": "keyword.operator.muselang"
        }
      ]
    }
  }
}
