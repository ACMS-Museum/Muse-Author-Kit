{
  "MuseLang Room": {
    "prefix": "mroom",
    "body": [
      "room ${1:room_id} \"${2:Display Name}\"",
      "  desc \"${3:Room description.}\""
    ],
    "description": "Insert a MuseLang 3 room."
  },
  "MuseLang Object": {
    "prefix": "mobj",
    "body": [
      "object ${1:object_id} in ${2:room_id} from ${3:device}",
      "  alias \"${4:alias}\"",
      "  state ${5:open} = ${6:false}",
      "",
      "  verb ${7:examine}",
      "    say \"${8:What the visitor sees.}\""
    ],
    "description": "Insert a MuseLang 3 object with state and a verb."
  },
  "MuseLang Character": {
    "prefix": "mchar",
    "body": [
      "character ${1:character_id} in ${2:room_id}",
      "  alias \"${3:alias}\"",
      "  desc \"${4:Character description.}\""
    ],
    "description": "Insert a MuseLang 3 character."
  },
  "MuseLang Goal": {
    "prefix": "mgoal",
    "body": [
      "goal ${1:goal_id}",
      "  desc \"${2:Goal description.}\""
    ],
    "description": "Insert a MuseLang 3 goal."
  },
  "MuseLang Verb With Argument": {
    "prefix": "mverbarg",
    "body": [
      "verb ${1:enter} <${2:value}:${3:int}>",
      "  if ${2:value} == ${4:1977}",
      "    say \"${5:That works.}\"",
      "  else",
      "    say \"${6:That does not work.}\""
    ],
    "description": "Insert a MuseLang 3 verb with a typed argument."
  },
  "MuseLang Routine": {
    "prefix": "mroutine",
    "body": [
      "routine ${1:status}",
      "  say \"${2:Status text.}\"",
      "",
      "verb ${3:check}",
      "  run ${1:status}"
    ],
    "description": "Insert a MuseLang 3 routine and caller verb."
  },
  "MuseLang For Loop": {
    "prefix": "mfor",
    "body": [
      "for ${1:i} = ${2:1} to ${3:10}",
      "  say \"{${1:i}}\""
    ],
    "description": "Insert a MuseLang 3 counted for loop."
  },
  "MuseLang Array": {
    "prefix": "marray",
    "body": [
      "array ${1:world.board}[${2:2},${3:3}] = ${4:0}"
    ],
    "description": "Insert a MuseLang 3 array declaration."
  }
}
